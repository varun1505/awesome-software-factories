{
  // Static site: VitePress builds README.md into .vitepress/dist, Cloudflare serves it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awesome-software-factories",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".vitepress/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "awesome-harnessengineering.fyi", "custom_domain": true }
  ]
}
